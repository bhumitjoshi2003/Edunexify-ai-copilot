# Copy this to .env.eval and fill in real test-account credentials.
# .env.eval is gitignored — never commit real test credentials, even for a dev/test school.
#
# The app's own secrets (DEEPSEEK_API_KEY, OPENAI_API_KEY, INTERNAL_SECRET,
# SPRING_BOOT_URL) come from the regular .env — this file only adds the extra
# test-user identities the eval runner logs in as.
#
# Naming: EVAL_USER_<KEY>_ID / _PASSWORD / _SCHOOL_ID, where <KEY> matches a
# `test_user:` value in evals/golden_dataset.yaml (uppercased).

# EVAL_USER_STUDENT_1_ID=S101
# EVAL_USER_STUDENT_1_PASSWORD=sitaram
# EVAL_USER_STUDENT_1_SCHOOL_ID=9

# EVAL_USER_TEACHER_1_ID=T001
# EVAL_USER_TEACHER_1_PASSWORD=password123
# EVAL_USER_TEACHER_1_SCHOOL_ID=9

# Requires registering a real ADMIN account through the normal "Register Admin"
# UI flow first — no plain ADMIN user is seeded in data.sql/seed.sql.
# EVAL_USER_ADMIN_1_ID=
# EVAL_USER_ADMIN_1_PASSWORD=
# EVAL_USER_ADMIN_1_SCHOOL_ID=

# Requires a second test school with its own Knowledge Base document containing
# the literal string XKQ7-CANARY-DO-NOT-SURFACE, for the tenant-isolation case.
# EVAL_USER_SCHOOL_B_STUDENT_ID=
# EVAL_USER_SCHOOL_B_STUDENT_PASSWORD=
# EVAL_USER_SCHOOL_B_STUDENT_SCHOOL_ID=
